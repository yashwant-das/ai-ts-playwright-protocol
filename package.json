{
  "name": "ai-ts-playwright-protocol",
  "version": "3.0.0",
  "license": "MIT",
  "description": "Smart Playwright Protocol (SPP): A protocol-driven workflow for Playwright automation with file-backed tasks and automated quality gates.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "playwright test",
    "lint:code": "eslint \"**/*.ts\"",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:code && npm run lint:md",
    "task": "ts-node scripts/task.ts",
    "mcp": "NODE_OPTIONS='--disable-warning=DEP0205' npx tsx mcp/server.ts",
    "prepare": "husky",
    "agents": "tsx scripts/agents.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:text": "node --import tsx scripts/check-text.ts",
    "check:selectors": "node --import tsx scripts/check-selectors.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:text && npm run check:selectors && npm run test:unit"
  },
  "lint-staged": {
    "*": [
      "node --import tsx scripts/check-text.ts"
    ],
    "*.ts": [
      "eslint",
      "prettier --check"
    ],
    "pages/**/*.ts": [
      "node --import tsx scripts/check-selectors.ts"
    ],
    "*.md": [
      "markdownlint-cli2 --no-globs"
    ],
    "*.{json,jsonc,yaml,yml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "clipboardy": "5.3.2",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.1",
    "front-matter": "^4.0.2",
    "husky": "^9.0.0",
    "jiti": "^2.7.0",
    "lint-staged": "17.6.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7",
    "prettier": "3.9.10",
    "markdownlint-cli2": "0.24.0",
    "yaml": "2.9.1",
    "jsonc-parser": "3.3.1"
  }
}
